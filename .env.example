# Your store's myshopify domain (NOT your custom domain, NOT admin.shopify.com)
VITE_SHOPIFY_STORE_DOMAIN=dkzv0p-4g.myshopify.com

# Public Storefront API access token — from the "Headless" sales channel app.
# This token is safe to ship to the browser. Never put an Admin API token here.
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Storefront API version (Shopify releases quarterly: YYYY-01/04/07/10)
VITE_SHOPIFY_API_VERSION=2026-07

# Branding shown in the header, footer and page titles
VITE_STORE_NAME=Lumière Beauty
